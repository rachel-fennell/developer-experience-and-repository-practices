{
  "name": "scheduler",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "scheduler",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=26 <27"
      }
    },
    "apps/api": {
      "name": "@scheduler/api",
      "dependencies": {
        "@scheduler/booking-rules": "*"
      }
    },
    "node_modules/@scheduler/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@scheduler/booking-rules": {
      "resolved": "packages/booking-rules",
      "link": true
    },
    "packages/booking-rules": {
      "name": "@scheduler/booking-rules",
      "version": "1.0.0"
    }
  }
}
